    cols.push(c.r, c.g, c.b);
  }
  g.setAttribute('color', new THREE.Float32BufferAttribute(cols, 3));
  scene.add(new THREE.Mesh(g, basic({ vertexColors: true, side: THREE.BackSide, fog: false })));
  // sun disk
  const sd = new THREE.Mesh(new THREE.CircleGeometry(4.2, 12), basic({ color: '#fff4c2', fog: false }));
  const halo = new THREE.Mesh(new THREE.CircleGeometry(6.5, 12), basic({ color: '#ffe39a', fog: false, transparent: true, opacity: 0.45 }));
  sd.position.set(-26, 13, -78); halo.position.set(-26, 13, -78.2); sd.lookAt(CAM_POS); halo.lookAt(CAM_POS);
  scene.add(halo, sd);
}
const clouds = [];
{
  const cw = basic({ color: '#ffffff', fog: false }), cp = basic({ color: '#ffd9e8', fog: false });
  const spots = [[-14, 17, -70], [12, 20, -74], [30, 15, -66], [-38, 22, -62], [4, 25, -80]];
  for (const [x, y, z] of spots) {
    const grp = new THREE.Group();
    const n = 4 + Math.floor(R() * 4);
    for (let i = 0; i < n; i++) {
      const s = 2 + R() * 3;
      const b = new THREE.Mesh(new THREE.BoxGeometry(s * 1.6, s * 0.8, s), i % 3 === 0 ? cp : cw);
      b.position.set((i - n / 2) * 2.2 + R(), (R() - 0.3) * 1.5, R() * 2);
      grp.add(b);
    }
    grp.position.set(x, y, z); scene.add(grp); clouds.push(grp);
  }
}

