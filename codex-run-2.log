// ---------- sky ----------
{
  const g = new THREE.SphereGeometry(90, 24, 16);
  const cols = []; const c = new THREE.Color();
  const top = new THREE.Color('#3f7fe0'), mid = new THREE.Color('#9cc9ff'), low = new THREE.Color('#ffd09a'), hor = new THREE.Color('#ffb98a');
  const p = g.attributes.position;
  for (let i = 0; i < p.count; i++) {
    const y = p.getY(i) / 90;
    if (y > 0.35) c.copy(mid).lerp(top, (y - 0.35) / 0.65);
    else if (y > 0.08) c.copy(low).lerp(mid, (y - 0.08) / 0.27);
