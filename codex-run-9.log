"""Run every Playwright suite with bounded waits (serve the app on port 8000)."""
from pathlib import Path
import runpy
import subprocess
import sys

if len(sys.argv)>1 and sys.argv[1]=='--worker':
 from playwright.async_api import Browser, BrowserContext
 original=BrowserContext.new_page
 async def new_page(self,*args,**kwargs):
  page=await original(self,*args,**kwargs)
  page.set_default_timeout(8000)
  page.set_default_navigation_timeout(12000)
  return page
 BrowserContext.new_page=new_page
 browser_original=Browser.new_page
 async def browser_new_page(self,*args,**kwargs):
  page=await browser_original(self,*args,**kwargs)
  page.set_default_timeout(8000)
  page.set_default_navigation_timeout(12000)
  return page
 Browser.new_page=browser_new_page
 runpy.run_path(sys.argv[2],run_name='__main__')
else:
 root=Path(__file__).resolve().parent.parent
 failed=[]
 for suite in sorted((root/'tests').glob('*_check.py')):
  print(f'Running {suite.name}',flush=True)
  try:
   result=subprocess.run([sys.executable,__file__,'--worker',str(suite)],cwd=root,timeout=150)
   if result.returncode:failed.append(suite.name)
  except subprocess.TimeoutExpired:
   print(f'{suite.name}: exceeded 150-second suite limit',flush=True)
   failed.append(suite.name)
 print('Failed: '+', '.join(failed) if failed else 'All Playwright suites passed',flush=True)
 sys.exit(bool(failed))
import asyncio
from pathlib import Path
from playwright.async_api import async_playwright

async def main():
 async with async_playwright() as p:
  browser=await p.chromium.launch(args=['--no-sandbox'])
  page=await browser.new_page(ignore_https_errors=True)
  page.set_default_timeout(8000)
  errors=[]
  page.on('pageerror',lambda e:errors.append(str(e)))
  source=Path('index.html').read_text().replace('window.__game = {','window.__view={camera,CAM_LOOK,THREE,bags,RX}; window.__game = {')
  await page.route('http://127.0.0.1:8000/',lambda r:r.fulfill(body=source,content_type='text/html'))
  for width,height in [(1280,800),(480,360),(390,844),(844,390)]:
   await page.set_viewport_size({'width':width,'height':height})
   await page.goto('http://127.0.0.1:8000/');await page.wait_for_function('!!window.__game')
   await page.evaluate('__game.startMatch({vs:"2p",first:0})')
   await page.wait_for_timeout(1800)
   assert await page.locator('#n0').inner_text()=='RED'
   assert 'RED RED' not in await page.locator('#t0').inner_text()
   assert await page.locator('#hint').count()==0
   assert await page.locator('#more, #touch-controls, [data-spin], [data-control], #step-value').count()==0
