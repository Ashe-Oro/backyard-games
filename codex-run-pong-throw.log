*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#153f3d;touch-action:none;user-select:none;-webkit-user-select:none}
body{font-family:'Press Start 2P',monospace;color:var(--cream)}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid var(--cream);outline-offset:4px}button:disabled{opacity:.45;cursor:default}[hidden]{display:none!important}
#game{position:fixed;inset:0;isolation:isolate}#game>canvas{display:block;width:100%;height:100%;image-rendering:pixelated}#game.drag{cursor:grabbing}
