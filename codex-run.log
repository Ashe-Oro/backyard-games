// ---------- cornhole boards ----------
function boardTexture(main, accent, sunTop, sunBot) {
  return pixTex(32, 64, (g) => {
    for (let y = 0; y < 64; y++) for (let x = 0; x < 32; x++) px(g, x, y, R() < 0.12 ? accent.shade : main);
    g.fillStyle = '#fff4dc'; g.fillRect(0, 0, 32, 2); g.fillRect(0, 62, 32, 2); g.fillRect(0, 0, 2, 64); g.fillRect(30, 0, 2, 64);
    const hx = 15.5, hy = 64 * (HOLE_FROM_TOP / L);
    for (let y = 0; y < 30; y++) for (let x = 0; x < 32; x++) {
      const d = Math.hypot(x + 0.5 - hx - 0.5, y + 0.5 - hy);
      if (d < 11.5 && !(y > hy + 2 && (Math.floor(y - hy) % 3 === 0))) {
        const t = clamp((y - (hy - 11)) / 22, 0, 1);
        px(g, x, y, t < 0.5 ? sunTop : sunBot);
      }
    }
    for (let y = 0; y < 64; y++) for (let x = 0; x < 32; x++) { const d = Math.hypot(x + 0.5 - hx - 0.5, y + 0.5 - hy); if (d > 4.3 && d < 5.6) px(g, x, y, '#fff4dc'); }
    // stripes + pixel star near bottom
    for (let i = 0; i < 3; i++) { g.fillStyle = i === 1 ? '#fff4dc' : accent.c; g.fillRect(2, 40 + i * 3, 28, 2); }
    const star = ['..#..', '..#..', '#####', '.###.', '.#.#.'];
    star.forEach((r, y) => [...r].forEach((ch, x) => ch === '#' && px(g, 13 + x, 52 + y, '#ffe45e')));
  });
}
function makeBoard(design) {
  const outer = new THREE.Group();
  const deckG = new THREE.Group();
  deckG.position.set(0, FRONT_H, 0); deckG.rotation.x = TH; outer.add(deckG);
  const shape = new THREE.Shape();
  shape.moveTo(-W / 2, 0); shape.lineTo(W / 2, 0); shape.lineTo(W / 2, L); shape.lineTo(-W / 2, L); shape.closePath();
  const hole = new THREE.Path(); hole.absarc(0, L - HOLE_FROM_TOP, HOLE_R, 0, Math.PI * 2, true); shape.holes.push(hole);
  const eg = new THREE.ExtrudeGeometry(shape, { depth: 0.02, bevelEnabled: false, curveSegments: 14 });
  const tx = design; tx.repeat.set(1 / W, 1 / L); tx.offset.set(0.5, 0);
  const skirtMat = lam('#d9a066');
  const deck = new THREE.Mesh(eg, [lam({ map: tx }), skirtMat]);
  deck.rotation.x = -Math.PI / 2; deck.position.y = -0.02; deck.castShadow = deck.receiveShadow = true;
  deckG.add(deck);
  const sk = 0.09;
  box(0.025, sk, L, skirtMat, -W / 2 + 0.0125, -sk / 2 - 0.02, -L / 2, deckG);
  box(0.025, sk, L, skirtMat, W / 2 - 0.0125, -sk / 2 - 0.02, -L / 2, deckG);
  box(W, sk, 0.025, skirtMat, 0, -sk / 2 - 0.02, -0.0125, deckG);
  box(W, sk, 0.025, skirtMat, 0, -sk / 2 - 0.02, -L + 0.0125, deckG);
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(W - 0.05, L - 0.05), basic('#1c120c'));
  floor.rotation.x = -Math.PI / 2; floor.position.set(0, -0.1, -L / 2); deckG.add(floor);
  const legH = BACK_H + 0.02;
  for (const x of [-W / 2 + 0.05, W / 2 - 0.05]) box(0.05, legH, 0.05, skirtMat, x, legH / 2 - 0.05, -L * Math.cos(TH) + 0.08, outer);
  return { outer, deckG };
}
