const boardInv = new THREE.Matrix4().copy(target.deckG.matrixWorld).invert();
const boardQ = new THREE.Quaternion(); target.deckG.getWorldQuaternion(boardQ);
const boardQi = boardQ.clone().invert();
const HOLE_LOCAL = new THREE.Vector3(0, 0, -(L - HOLE_FROM_TOP));
HOLE_WORLD.copy(HOLE_LOCAL).applyMatrix4(target.deckG.matrixWorld);
const G_LOCAL = new THREE.Vector3(0, -G, 0).applyQuaternion(boardQi);
const G_N = -G_LOCAL.y, G_T = Math.hypot(G_LOCAL.x, G_LOCAL.z);
const toLocal = (v, out = new THREE.Vector3()) => out.copy(v).applyMatrix4(boardInv);
const toWorld = (v, out = new THREE.Vector3()) => out.copy(v).applyMatrix4(target.deckG.matrixWorld);
const baseYaw = (rx) => Math.atan2(HOLE_WORLD.x - rx, -(HOLE_WORLD.z - REL_Z));
const inFootprint = (p) => Math.abs(p.x) < W / 2 + 0.02 && p.z < BOARD_Z + 0.02 && p.z > BOARD_Z - L * Math.cos(TH);
const holeDist = (lp) => Math.hypot(lp.x - HOLE_LOCAL.x, lp.z - HOLE_LOCAL.z);

// ---------- bag physics ----------
// states: fly -> slide/board (on deck) | ground/grass (on lawn) | hole -> in | removed (dead bag taken away)
function newBody(team, side = 'slick') {
  return { team, side, state: 'fly', p: new THREE.Vector3(), v: new THREE.Vector3(), lp: new THREE.Vector3(), lv: new THREE.Vector3(), prev: new THREE.Vector3(), curl: 0, touched: false, dead: false, swish: false, offBoard: false, t: 0, restT: 0 };
}
function launch(b, rx, power, aim, drift) {
  const speed = V_MIN + clamp(power, 0, 1) * (V_MAX - V_MIN);
  const y = baseYaw(rx) + aim + drift * 0.04;
  b.p.set(rx, REL_Y, REL_Z);
  b.v.set(Math.sin(y) * Math.cos(ELEV) * speed, Math.sin(ELEV) * speed, -Math.cos(y) * Math.cos(ELEV) * speed);
  b.curl = drift * 0.8; b.state = 'fly';
