  M.first = opts.first != null ? opts.first : (Math.random() < 0.5 ? 0 : 1);   // coin toss
  ui.panel.hidden = true; ui.title.classList.add('gone');
  say('COIN TOSS', TEAM[M.first] + ' THROWS FIRST', 1500);
  beginInning(900);
}
function beginInning(delay = 300) {
  clearBags(); M.k = 0; M.phase = 'wait'; renderHud();
  setTimeout(nextTurn, delay);
}
function nextTurn() {
  if (M.k >= 8) { M.phase = 'settle'; renderHud(); return; }
  const t = thrower(); M.aim = 0; setMeter(0);
  held.material = TEAM_MATS[t][M.side[t] === 'slick' ? 'sticky' : 'slick'];
  if (isHuman(t)) M.phase = 'aim';
  else {
    const side = Math.random() < 0.3 ? 'sticky' : 'slick';
    M.side[1] = side;
    const w = WIN[1 + side];
    M.cpu = { t: 0, side, power: w.mid + gauss() * 0.055, aim: gauss() * 0.02, drift: gauss() * 0.18 };
    M.phase = 'cpu';
  }
  renderHud();
}
function throwBag(power, drift = 0, team = thrower()) {
