    const sp = Math.hypot(lv.x, lv.z), dec = S.mu * G_N * dt;
    if (sp <= dec) { lv.x = 0; lv.z = 0; } else { lv.x -= lv.x / sp * dec; lv.z -= lv.z / sp * dec; }
    b.curl *= Math.pow(0.2, dt);
