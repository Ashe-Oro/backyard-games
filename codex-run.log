<script type="module">
import * as THREE from 'three';

// ---------- constants (regulation ACL/ACA dimensions, metres) ----------
const G = 9.8;
const IN = 0.0254, FT = 0.3048;
const W = 2 * FT, L = 4 * FT;              // 2 ft x 4 ft deck
const FRONT_H = 3.5 * IN, BACK_H = 12 * IN; // front 2.5-4 in, back 12 in
const TH = Math.asin((BACK_H - FRONT_H) / L);
const BOARD_Z = -27 * FT;                   // 27 ft front edge to front edge; our foul line is z = 0
const HOLE_FROM_TOP = 9 * IN, HOLE_R = 3 * IN; // 6 in hole, centre 9 in from the top
const BAG = 6 * IN, BAG_H = 0.016, BAG_R = 0.074; // 6x6 in, ~1.25 in thick
const SIDES = { slick: { mu: 0.30, ms: 0.5, keep: 0.42 }, sticky: { mu: 0.62, ms: 0.85, keep: 0.30 } };
const MU_GROUND = 1.1, BAG_E = 0.25;
const ELEV = 35 * Math.PI / 180;
const V_MIN = 7.15, V_MAX = 10.55;
const AIM_MAX = 0.12;
const FLICK_MIN = 0.5, FLICK_MAX = 5.5;     // screen heights / second
const REL_Y = 1.3, REL_Z = -0.45;           // feet stay behind the foul line (z = 0); the hand reaches past it on release
const RX = [0.62, -0.62];                   // red throws from the right pitcher's box, blue from the left
const TEAM = ['RED', 'BLUE'];
const HOLE_WORLD = new THREE.Vector3();

const params = new URLSearchParams(location.search);
const POSTER = params.has('poster');

// ---------- utils ----------
function rng(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
const R = rng(7);
const pick = a => a[Math.floor(R() * a.length)];
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
function pixTex(w, h, draw, rep = [1, 1]) {
  const c = document.createElement('canvas'); c.width = w; c.height = h;
  const g = c.getContext('2d'); draw(g, w, h);
  const t = new THREE.CanvasTexture(c);
  t.magFilter = THREE.NearestFilter; t.minFilter = THREE.NearestFilter; t.generateMipmaps = false;
  t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]);
  return t;
}
const px = (g, x, y, c, w = 1, h = 1) => { g.fillStyle = c; g.fillRect(x, y, w, h); };
const lam = (o) => new THREE.MeshLambertMaterial(typeof o === 'string' ? { color: o } : o);
const basic = (o) => new THREE.MeshBasicMaterial(typeof o === 'string' ? { color: o } : o);
function box(w, h, d, mat, x = 0, y = 0, z = 0, parent) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
  m.position.set(x, y, z); m.castShadow = true; m.receiveShadow = true;
  if (parent) parent.add(m); return m;
}

// ---------- renderer ----------
const wrap = document.getElementById('game');
let renderer;
try {
  renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: 'high-performance' });
} catch (e) { document.getElementById('err').style.display = 'flex'; throw e; }
renderer.setPixelRatio(1);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.BasicShadowMap;
wrap.prepend(renderer.domElement);

const scene = new THREE.Scene();
scene.fog = new THREE.Fog('#ffd3a8', 26, 75);
const camera = new THREE.PerspectiveCamera(19, 1, 0.1, 200);
const CAM_POS = new THREE.Vector3(0.5, 2.05, 2.45);
camera.position.copy(CAM_POS); camera.lookAt(0, 0.5, -8.7);

function resize() {
  const w = wrap.clientWidth, h = wrap.clientHeight;
  const scale = Math.max(1, Math.round(Math.min(h, w * 0.85) / 240));
  renderer.setSize(Math.ceil(w / scale), Math.ceil(h / scale), false);
  camera.aspect = w / h;
  camera.fov = w / h < 1 ? 19 + (1 - w / h) * 30 : 19;
  camera.updateProjectionMatrix();
}
addEventListener('resize', resize); resize();

// ---------- lights ----------
scene.add(new THREE.HemisphereLight('#d6ecff', '#7a8f3a', 1.4));
const sun = new THREE.DirectionalLight('#ffe0b0', 2.6);
sun.position.set(-7, 12, 5); sun.target.position.set(0, 0, -5);
sun.castShadow = true; sun.shadow.mapSize.set(1024, 1024);
Object.assign(sun.shadow.camera, { left: -14, right: 14, top: 14, bottom: -14, near: 1, far: 40 });
sun.shadow.bias = -0.0006; sun.shadow.normalBias = 0.02;
scene.add(sun, sun.target);

// ---------- sky ----------
{
  const g = new THREE.SphereGeometry(90, 24, 16);
  const cols = []; const c = new THREE.Color();
  const top = new THREE.Color('#3f7fe0'), mid = new THREE.Color('#9cc9ff'), low = new THREE.Color('#ffd09a'), hor = new THREE.Color('#ffb98a');
  const p = g.attributes.position;
  for (let i = 0; i < p.count; i++) {
    const y = p.getY(i) / 90;
    if (y > 0.35) c.copy(mid).lerp(top, (y - 0.35) / 0.65);
    else if (y > 0.08) c.copy(low).lerp(mid, (y - 0.08) / 0.27);
    else c.copy(hor).lerp(low, clamp((y + 0.1) / 0.18, 0, 1));
    cols.push(c.r, c.g, c.b);
  }
  g.setAttribute('color', new THREE.Float32BufferAttribute(cols, 3));
  scene.add(new THREE.Mesh(g, basic({ vertexColors: true, side: THREE.BackSide, fog: false })));
  // sun disk
  const sd = new THREE.Mesh(new THREE.CircleGeometry(4.2, 12), basic({ color: '#fff4c2', fog: false }));
  const halo = new THREE.Mesh(new THREE.CircleGeometry(6.5, 12), basic({ color: '#ffe39a', fog: false, transparent: true, opacity: 0.45 }));
  sd.position.set(-26, 13, -78); halo.position.set(-26, 13, -78.2); sd.lookAt(CAM_POS); halo.lookAt(CAM_POS);
  scene.add(halo, sd);
}
const clouds = [];
{
  const cw = basic({ color: '#ffffff', fog: false }), cp = basic({ color: '#ffd9e8', fog: false });
  const spots = [[-14, 17, -70], [12, 20, -74], [30, 15, -66], [-38, 22, -62], [4, 25, -80]];
  for (const [x, y, z] of spots) {
    const grp = new THREE.Group();
    const n = 4 + Math.floor(R() * 4);
    for (let i = 0; i < n; i++) {
      const s = 2 + R() * 3;
      const b = new THREE.Mesh(new THREE.BoxGeometry(s * 1.6, s * 0.8, s), i % 3 === 0 ? cp : cw);
      b.position.set((i - n / 2) * 2.2 + R(), (R() - 0.3) * 1.5, R() * 2);
      grp.add(b);
    }
    grp.position.set(x, y, z); scene.add(grp); clouds.push(grp);
  }
}

// ---------- ground ----------
{
  const grass = pixTex(32, 32, (g, w, h) => {
    for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
      const light = x < 16;
      const pal = light ? ['#6fcf4a', '#79d651', '#66c444', '#82dc59'] : ['#5bb83e', '#63bf43', '#52aa38', '#6cc648'];
      px(g, x, y, pick(pal));
    }
    for (let i = 0; i < 6; i++) { const x = Math.floor(R() * w), y = Math.floor(R() * h); px(g, x, y, '#9be86b'); px(g, x, y + 1, '#4a9a32'); }
  }, [24, 24]);
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(72, 72), lam({ map: grass }));
  ground.rotation.x = -Math.PI / 2; ground.rotation.z = Math.PI / 2; ground.position.z = -6; ground.receiveShadow = true;
  scene.add(ground);
  // flowers scattered in lawn
  const fl = new THREE.InstancedMesh(new THREE.BoxGeometry(0.045, 0.03, 0.045), basic('#ffffff'), 110);
  const fc = ['#ffffff', '#ffe45e', '#ff8fb6', '#ffffff', '#b98cff'];
  const m4 = new THREE.Matrix4(), col = new THREE.Color();
  for (let i = 0; i < 110; i++) {
    let x = (R() - 0.5) * 14, z = -1 - R() * 11.5;
    if (Math.abs(x) < 1.6) x += Math.sign(x || 1) * 1.8;
    m4.makeTranslation(x, 0.03, z); fl.setMatrixAt(i, m4); fl.setColorAt(i, col.set(pick(fc)));
  }
  scene.add(fl);
}

// ---------- fence ----------
{
  const wood = pixTex(4, 16, (g) => {
    for (let y = 0; y < 16; y++) for (let x = 0; x < 4; x++) px(g, x, y, pick(['#e0a96b', '#d89f60', '#e6b376']));
    for (let y = 0; y < 16; y++) px(g, 3, y, '#b97f47');
    px(g, 1, 5, '#a86f3c'); px(g, 2, 11, '#a86f3c');
  });
  const pickets = [];
