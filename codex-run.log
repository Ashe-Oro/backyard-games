  const side = M.side[team];
  const b = newBody(team, side); launch(b, RX[team], power, M.aim, drift);
  b.mesh = makeBagMesh(team, side); b.mesh.position.copy(b.p);
  b.spin = drift * 14 + (Math.random() - 0.5) * 2; b.tumble = 0.6 + Math.random();
  M.before = bags.map((o) => ({ o, s: o.state }));
  bags.push(b); M.active = b; M.phase = 'flying'; M.lastPower = power; setMeter(power);
  renderHud();
  return true;
}
function afterThrow() {
  const b = M.active; M.active = null;
  const knockedIn = M.before.filter(({ o, s }) => s !== 'in' && o.state === 'in');
  const knockedOff = M.before.filter(({ o, s }) => s === 'board' && !onDeck(o) && o.state !== 'in');
  if (b.state === 'in') { say(b.swish ? 'SWISH!' : 'CORNHOLE!', 'IN THE HOLE · 3'); burst(HOLE_WORLD.clone().setY(HOLE_WORLD.y + 0.1)); }
  else if (b.state === 'board') say(holeDist(b.lp) < HOLE_R + BAG_R * 0.6 ? 'HANGER!' : 'WOODY', 'ON THE BOARD · 1');
  else if (b.dead) say('GROUNDER', 'HIT THE GRASS FIRST · REMOVED', 1300);
  else say(b.offBoard ? 'OFF THE BOARD' : 'MISS', '0', 1100);
  if (knockedIn.length) { setTimeout(() => say('KNOCKED IN!', knockedIn.map(({ o }) => TEAM[o.team]).join(' + ') + ' BAG +3'), 900); burst(HOLE_WORLD.clone().setY(HOLE_WORLD.y + 0.1)); }
  else if (knockedOff.length) setTimeout(() => say('KNOCKED OFF!', knockedOff.map(({ o }) => TEAM[o.team]).join(' + ') + ' BAG'), 900);
  M.k++; M.phase = 'wait'; renderHud();
  setTimeout(nextTurn, knockedIn.length || knockedOff.length ? 1500 : 750);
}
function scoreInning() {
  const { pts, inC, onC } = lie();
  const net = Math.abs(pts[0] - pts[1]);
  const scorer = pts[0] > pts[1] ? 0 : pts[1] > pts[0] ? 1 : -1;
  let bust = false;
  if (scorer >= 0) {
    M.scores[scorer] += net;
    if (M.exact && M.scores[scorer] > 21) { M.scores[scorer] = 13; bust = true; }
    M.first = scorer;                 // last scoring team throws first; a wash keeps the same order
  }
  const win = scorer >= 0 && (M.exact ? M.scores[scorer] === 21 : M.scores[scorer] >= 21) ? scorer : -1;
  M.history.push({ inning: M.inning, pts, inC, onC, net, scorer, bust, scores: [...M.scores] });

