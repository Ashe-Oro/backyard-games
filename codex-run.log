    if (holeDist(lp) < HOLE_R - 0.012) { b.state = 'hole'; b.hy = BAG_H; return 'hole'; }
    if (Math.abs(lp.x) > W / 2 + 0.01 || lp.z > 0.01 || lp.z < -L - 0.01) {
      toWorld(lp, b.p); b.v.copy(lv).applyQuaternion(boardQ); b.state = 'fly'; b.offBoard = true; return 'off';
    }
    if (Math.hypot(lv.x, lv.z) < 0.02 && G_T < S.ms * G_N) { lv.set(0, 0, 0); b.state = 'board'; toWorld(lp, b.p); return 'rest'; }
