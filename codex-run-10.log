function simulate(rx, power, side, aim = 0, drift = 0, arc = 1) {
  const b = newBody(0, side); launch(b, rx, power, aim, drift, arc);
  for (let i = 0; i < 240 * 8; i++) { step(b, 1 / 240); if (['board', 'grass', 'in', 'removed'].includes(b.state)) break; }
  return b.state === 'in' ? 3 : b.state === 'board' ? 1 : 0;
}
// power windows for the meter / CPU, per thrower box and bag side
const WIN = {};
for (const t of [0, 1]) for (const side of ['slick', 'sticky']) for (const arc of [0, 1, 2]) {
  let lo = 1, hi = 0, olo = 1, ohi = 0;
  for (let p = 0; p <= 1; p += 0.0025) { const r = simulate(RX[t], p, side, 0, 0, arc); if (r === 3) { lo = Math.min(lo, p); hi = Math.max(hi, p); } if (r >= 1) { olo = Math.min(olo, p); ohi = Math.max(ohi, p); } }
  WIN[t + side + arc] = { lo, hi, olo, ohi, mid: hi >= lo ? (lo + hi) / 2 : (olo + ohi) / 2 };
}

// ---------- bag meshes ----------
function bagTexture(c, dark, light, sticky) {
  return pixTex(8, 8, (g) => {
    for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) px(g, x, y, sticky ? ((x * 3 + y * 5) % 7 === 0 ? dark : c) : ((x + y) % 3 === 0 ? light : c));
    for (let i = 0; i < 8; i++) { px(g, i, 0, dark); px(g, i, 7, dark); px(g, 0, i, dark); px(g, 7, i, dark); }
    for (let i = 1; i < 7; i += 2) { px(g, i, 1, '#fff4dc'); px(g, i, 6, '#fff4dc'); }
  });
function advance() {
  if (M.phase === 'summary') { ui.panel.hidden = true; M.inning++; beginInning(); }
  else if (M.phase === 'over') { clearBags(); showMenu(); }
}


function meterWindow(){
 const t=thrower(),w=WIN[t+M.side[t]+M.arc];
 if(!M.sweetShift)return {...w};
 const width=Math.max(.014,(w.hi-w.lo)*.78),mid=M.sweetShift;
 return {...w,lo:mid-width/2,hi:mid+width/2,mid};
}
function physicalPower(p){
 if(!M.sweetShift)return p;
 const t=thrower(),base=WIN[t+M.side[t]+M.arc],w=meterWindow();
 if(p<w.lo)return p/w.lo*base.lo;
 if(p>w.hi)return base.hi+(p-w.hi)/(1-w.hi)*(1-base.hi);
 return base.lo+(p-w.lo)/(w.hi-w.lo)*(base.hi-base.lo);
}
