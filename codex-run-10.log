import asyncio
from pathlib import Path
from playwright.async_api import async_playwright

async def main():
 async with async_playwright() as p:
  browser=await p.chromium.launch(args=['--no-sandbox'])
  page=await browser.new_page(ignore_https_errors=True)
  page.set_default_timeout(8000)
  page.set_default_navigation_timeout(12000)
  errors=[]
  page.on('pageerror',lambda e:errors.append(str(e)))
  source=Path('index.html').read_text().replace('window.__game = {','window.__view={camera,aimDots,held}; window.__game = {')
  await page.route('http://127.0.0.1:8000/',lambda r:r.fulfill(body=source,content_type='text/html'))
  await page.goto('http://127.0.0.1:8000/')
  await page.wait_for_function('!!window.__game')
  expected=None
  for width,height in [(1280,800),(390,844),(480,360),(844,390)]:
   await page.set_viewport_size({'width':width,'height':height})
   await page.evaluate('__game.startMatch({practice:true,vs:"2p",first:0})')
   await page.wait_for_function('__game.state.phase==="aim"')
   views=[]
   for side,x in [('left',2),('right',width-2)]:
    await page.mouse.move(x,height*.5)
    await page.wait_for_timeout(650)
    view=await page.evaluate('''()=>{const {camera,aimDots,held}=__view;return {position:camera.position.toArray(),target:camera.userData.look.toArray(),quaternion:camera.quaternion.toArray(),fov:camera.fov,aim:__game.state.aim,dot:aimDots[3].position.toArray(),held:held.rotation.y};}''')
    fixed={k:view[k] for k in ['position','target','quaternion','fov']}
    assert view['position']==[.5,2.05,2.45] and view['target']==[0,.5,-8.7] and view['fov']==19,view
    if expected is None: expected=fixed
    assert fixed==expected,(fixed,expected)
    views.append(view)
    await page.screenshot(path=f'shots/task9-{width}-{side}.png')
   assert views[0]['aim']<0<views[1]['aim'],views
   assert views[0]['dot']!=views[1]['dot'] and views[0]['held']!=views[1]['held'],views
  assert not errors,errors
  await browser.close()
  print('Batch 9: fixed camera position, target, rotation and FOV across pointer extremes and resize; moving indicators and held bag PASS')

if __name__=='__main__':
 asyncio.run(asyncio.wait_for(main(),timeout=150))
# Batch 9: static camera while aiming

Implemented CODEX_TASK_9.md fully.

- Removed the batch-6 camera-follow block, including aim/stance offsets, temporary vectors, and position/target lerps. The camera is initialized once at `(0.5, 2.05, 2.45)` looking at `(0, 0.5, -8.7)`.
- FOV remains 19, including portrait resize. Resize only updates aspect/projection and renderer dimensions; it cannot move or turn the camera.
- Pointer aiming still turns the aim dots, trajectory, and held bag. Left menu, PUSH/NORMAL/KOBE, SLICK/STICKY, and all batch 7–8 UI behavior remain intact. Removed controls and hints remain absent.
- Added `tests/task9_check.py`. Actual mouse movement to far-left and far-right positions checks identical camera position, target, quaternion, and FOV through page evaluations. It also verifies that aim, dots, and held-bag rotation change, and repeats after resizing across 1280×800, 390×844, 480×360, and 844×390.
- Saved eight screenshots as `shots/task9-{1280,390,480,844}-{left,right}.png`. Inspected the portrait screenshot.
- Updated batch-6 assertions from camera following to a fixed camera, and batch-5 assertions to fixed 19-degree FOV. With the explicitly requested constant FOV, the foreground held bag is partially cropped horizontally on narrow portrait screens; its visibility and vertical/depth placement are still checked, and desktop framing remains checked on both axes.

## Validation

All eight Playwright suites have passing results: career, main gameplay, task3, task5, task6, task8, task9, and wind/flag. The full runner initially reported only task5 failing because its old assertion required the entire bag inside the portrait viewport. After updating that assertion for constant FOV, its bounded rerun passed. No application changes were needed for that failure.

