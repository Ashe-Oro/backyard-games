import * as THREE from 'three';

// ---------- constants (regulation ACL/ACA dimensions, metres) ----------
const G = 9.8;
const IN = 0.0254, FT = 0.3048;
const W = 2 * FT, L = 4 * FT;              // 2 ft x 4 ft deck
const FRONT_H = 3.5 * IN, BACK_H = 12 * IN; // front 2.5-4 in, back 12 in
const TH = Math.asin((BACK_H - FRONT_H) / L);
const BOARD_Z = -27 * FT;                   // 27 ft front edge to front edge; our foul line is z = 0
const HOLE_FROM_TOP = 9 * IN, HOLE_R = 3 * IN; // 6 in hole, centre 9 in from the top
const BAG = 6 * IN, BAG_H = 0.016, BAG_R = 0.074; // 6x6 in, ~1.25 in thick
const SIDES = { slick: { mu: 0.30, ms: 0.5, keep: 0.42 }, sticky: { mu: 0.62, ms: 0.85, keep: 0.30 } };

function meterWindow(){
 const t=thrower(),w=WIN[t+M.side[t]+M.arc];
 const normal=WIN[t+M.side[t]+1],normalWidth=normal.hi-normal.lo;
 // Keep the calibrated physics range intact; KOBE gets a friendlier input range.
 const baseWidth=M.arc===2 ? normalWidth*.78 : w.hi-w.lo;
 if(!M.sweetShift && M.arc!==2)return {...w};
 const width=M.sweetShift ? Math.max(M.arc===2 ? normalWidth*.60 : .014,baseWidth*.78) : baseWidth;
 const mid=M.sweetShift || w.mid;
 const lo=mid-width/2,hi=mid+width/2;
