<body>
<div id="game">
  <div id="hud">
    <div id="sb" class="ol">
      <div class="team red" id="t0"><div class="tn">RED <span id="n0">YOU</span></div><div class="ts" id="s0">0</div><div class="pips" id="p0"></div></div>
      <div class="mid"><div id="inn">INNING 1</div><div id="goal">TO 21</div></div>
      <div class="team blue" id="t1"><div class="tn"><span id="n1">CPU</span> BLUE</div><div class="ts" id="s1">0</div><div class="pips" id="p1"></div></div>
    </div>
    <div id="title" class="ol"><h1>BACKYARD<br>CORNHOLE</h1><p>line up · flick · toss</p></div>
    <div id="turn" class="ol"></div>
    <div id="msg" class="ol"></div>
    <div id="meter"><div id="fill"></div><div id="onb"></div><div id="sweet"></div><div class="mlbl ol">PWR</div></div>
    <div id="conditions" class="ol"><div id="wind"></div><div id="setup"></div></div>
    <div id="touch-controls"><button class="hb" data-control="arrowleft" aria-label="STEP ←">STEP ←</button><button class="hb" data-control="arrowright" aria-label="STEP →">STEP →</button><button class="hb" data-control="a" aria-label="AIM ←">AIM ←</button><button class="hb" data-control="d" aria-label="AIM →">AIM →</button><button class="hb" data-control="q" aria-label="SPIN L">SPIN L</button><button class="hb" data-control="e" aria-label="SPIN R">SPIN R</button><button class="hb" data-control="s" aria-label="ARC −">ARC −</button><button class="hb" data-control="w" aria-label="ARC +">ARC +</button></div>
    <div id="hint" class="ol"></div>
    <div class="btns"><button class="hb" id="side" title="Which side of the bag lands down (F)">SLICK SIDE</button><button class="hb" id="mode" title="Toggle controls (M)">MOUSE</button></div>
  </div>
  <div id="panel" class="ol" hidden></div>
  <div id="err">WebGL isn't available here.<br>Open this page in a desktop browser.</div>
</div>
<script type="module">
import * as THREE from 'three';

// ---------- constants (regulation ACL/ACA dimensions, metres) ----------
const G = 9.8;
const IN = 0.0254, FT = 0.3048;
const W = 2 * FT, L = 4 * FT;              // 2 ft x 4 ft deck
const FRONT_H = 3.5 * IN, BACK_H = 12 * IN; // front 2.5-4 in, back 12 in
const TH = Math.asin((BACK_H - FRONT_H) / L);
const BOARD_Z = -27 * FT;                   // 27 ft front edge to front edge; our foul line is z = 0
}
function burst(at) { for (const c of confetti) { c.m.position.copy(at); c.v.set((Math.random() - 0.5) * 2.4, 1.5 + Math.random() * 2.5, (Math.random() - 0.5) * 2.4); c.life = 1 + Math.random() * 0.6; c.m.visible = true; } }

// ---------- match state ----------
const $ = (id) => document.getElementById(id);
const ui = { s: [$('s0'), $('s1')], p: [$('p0'), $('p1')], t: [$('t0'), $('t1')], n: [$('n0'), $('n1')], inn: $('inn'), goal: $('goal'), turn: $('turn'), msg: $('msg'), fill: $('fill'), sweet: $('sweet'), onb: $('onb'), hint: $('hint'), title: $('title'), mode: $('mode'), side: $('side'), panel: $('panel') };
const M = {
  vs: 'cpu', exact: false, scores: [0, 0], inning: 1, first: 0, k: 0, phase: 'menu', aim: 0, ctrl: 'drag',
  position: [0, 0], spin: 0, arc: 1, side: ['slick', 'slick'], active: null, before: null, cpu: null, history: [], winner: -1, lastPower: null,
};
const thrower = (k = M.k) => (k % 2 === 0 ? M.first : 1 - M.first);
const isHuman = (t) => t === 0 || M.vs === '2p';
const teamName = (t) => (M.vs === 'cpu' ? (t === 0 ? 'YOU' : M.career ? roster[career.fight].name : 'CPU') : TEAM[t]);
const settled = () => bags.every((b) => ['board', 'grass', 'in', 'removed'].includes(b.state) && !(b.state === 'grass' && b.dead));
function lie() { // score as the bags lie right now (only final after all 8)
  const pts = [0, 0], inC = [0, 0], onC = [0, 0];
  for (const b of bags) {
    if (b.state === 'in') { pts[b.team] += 3; inC[b.team]++; }
    else if (b.state === 'board' && !b.dead) { pts[b.team] += 1; onC[b.team]++; }
  }
  return { pts, inC, onC };
}
function renderHud() {
  for (const t of [0, 1]) {
    ui.s[t].textContent = M.scores[t];
    ui.n[t].textContent = teamName(t);
    const thrown = bags.filter((b) => b.team === t).length;
    ui.p[t].innerHTML = [0, 1, 2, 3].map((i) => `<i class="${i < thrown ? 'used' : ''}"></i>`).join('');
    ui.t[t].classList.toggle('now', (M.phase === 'aim' || M.phase === 'cpu') && thrower() === t);
  }
  ui.inn.textContent = 'INNING ' + M.inning;
  ui.goal.textContent = M.exact ? 'EXACTLY 21' : 'FIRST TO 21';
  const t = thrower();
  if (M.phase === 'aim' || M.phase === 'cpu') {
    ui.turn.className = 'ol ' + (t ? 'blue' : 'red');
    ui.turn.textContent = M.vs === 'cpu' ? (t === 0 ? 'YOUR THROW' : 'CPU IS THROWING...') : TEAM[t] + "'S THROW";
    ui.turn.style.opacity = 1;
  } else ui.turn.style.opacity = 0;
  $('wind').textContent = wind.mph===0 ? 'CALM AIR · 0 MPH' : `${['↑','↗','→','↘','↓','↙','←','↖'][Math.round(wind.angle / (Math.PI / 4)) % 8]} ${wind.mph} MPH`;
  $('setup').textContent = `${arcNames[M.arc]} · SPIN ${M.spin < 0 ? 'L' : M.spin > 0 ? 'R' : '0'} · STEP ${M.position[t].toFixed(2)}`;
  ui.side.textContent = (M.side[t] === 'slick' ? 'SLICK' : 'STICKY') + ' SIDE DOWN';
  ui.side.style.visibility = isHuman(t) ? 'visible' : 'hidden';
  const w = WIN[t + M.side[t] + M.arc];
  ui.sweet.style.bottom = (w.lo * 100) + '%'; ui.sweet.style.height = Math.max(2, (w.hi - w.lo) * 100) + '%';
  ui.onb.style.bottom = (w.olo * 100) + '%'; ui.onb.style.height = Math.max(2, (w.ohi - w.olo) * 100) + '%';
}
function hint() {
  ui.hint.innerHTML = 'SWIPE / FLICK UP · TRACKPAD: TWO-FINGER SWIPE<span class="l2"><br>← → STEP · A/D AIM · Q/E SPIN · W/S ARC · F SIDE · M SPINNER</span>';
  ui.mode.textContent = M.ctrl === 'drag' ? '🖱 MOUSE' : '🕹 SPINNER';
  wrap.classList.toggle('spin', M.ctrl === 'spin');
}
let msgTimer;
function say(big, small = '', ms = 1400) {
  ui.msg.innerHTML = big + (small ? `<small>${small}</small>` : ''); ui.msg.classList.add('on');
  clearTimeout(msgTimer); msgTimer = setTimeout(() => ui.msg.classList.remove('on'), ms);
}
function setMeter(p) { ui.fill.style.height = (clamp(p, 0, 1) * 100) + '%'; }
const gauss = () => { let u = 0, v = 0; while (!u) u = Math.random(); while (!v) v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

function clearBags() { for (const b of bags) scene.remove(b.mesh); bags.length = 0; }
// Career saves only completed fights; an interrupted match restarts the current opponent.
const roster = [
 ['Slidin’ Steve','The Patio Pusher','Beanbag Bend','2–7','Your bags are in my driveway!','slider','#45bca4',0],
 ['Big Bag Barb','Queen of the Cookout','Biscuit Bay','5–3','Hope you brought a bigger picnic!','blocker','#ed83bb',0],
 ['Kobe Kowalski','The Sky Slinger','Popcorn Plains','9–4','Forecast: bags from above!','lobber','#f6b642',1],
 ['Sticky Vicky','The Suede Sorceress','Velcro Valley','12–3','This victory is going to stick!','sniper','#a57cf0',1],
 ['Tailgate Ted','The Parking Lot Tornado','Grillville','16–5','I put the wild in wild card!','wild','#73b5f3',2],
 ['Slidin’ Steve II','Patio Pusher: Reloaded','Beanbag Bend','21–7','Same driveway. Double trouble!','slider','#26dcbb',2],
 ['Big Bag Barb II','The Cookout Empress','Biscuit Bay','28–3','You’re the side dish today!','blocker','#ff509f',3],
 ['Reign Supreme','The Bag Baroness','Crown Corners','35–0','The throne has no room for two!','champion','#ffe45e',3]
