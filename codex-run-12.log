.team{min-width:0}.team.blue{grid-column:3;text-align:right}
.tn{font-size:.9em;letter-spacing:.06em}
.red .tn{color:#ff8a80}.blue .tn{color:#9db8ff}
.ts{font-size:2.6em;margin-top:.3em;color:#ffe45e}
.pips{display:flex;gap:.4em;margin-top:.6em}.blue .pips{justify-content:flex-end}
.pips i{display:block;width:1.4em;height:1.4em;border:.22em solid #2b1a2e;box-shadow:inset -.22em -.22em 0 rgba(0,0,0,.25),inset .18em .18em 0 rgba(255,255,255,.35)}
.red .pips i{background:#e8423c}.blue .pips i{background:var(--rival,#3f6ee8)}
.pips i.used{background:#6b5a63!important;opacity:.4;box-shadow:none}
.team.now .tn::before{content:'▶ ';color:#ffe45e}
.blue.now .tn::before{content:''}.blue.now .tn::after{content:' ◀';color:#ffe45e}
.mid{grid-column:2;text-align:center;padding-top:.2em;max-width:58vw}#goal.practice{white-space:pre-line;line-height:1.7}
#inn{font-size:1em}#goal{font-size:.75em;margin-top:.7em;color:#ffb36b}
#turn{position:absolute;left:0;right:0;top:19%;text-align:center;font-size:1.25em;color:#fff;transition:opacity .3s}
#turn.red{color:#ff8a80}#turn.blue{color:#9db8ff}
#meter{position:absolute;right:1.8vmin;bottom:1.8vmin;width:2.2em;height:36%;border:.3em solid #2b1a2e;background:#3b2a40;box-shadow:.3em .3em 0 rgba(43,26,46,.35)}
#fill{position:absolute;left:0;right:0;bottom:0;height:0;background:repeating-linear-gradient(0deg,#ffb340 0 .5em,#ff8a3d .5em 1em)}
#sweet,#onb{position:absolute;left:-.55em;right:-.55em;height:6%}
#onb{border:.2em dashed rgba(255,255,255,.55)}
#sweet{border:0}
.mlbl{position:absolute;bottom:-.2em;right:calc(100% + .6em);font-size:.8em;white-space:nowrap}
#msg{position:absolute;left:0;right:0;top:31%;text-align:center;font-size:2.2em;color:#fff;opacity:0;transform:scale(.6);transition:opacity .25s,transform .25s cubic-bezier(.3,1.8,.5,1)}
#msg.on{opacity:1;transform:scale(1)}
#msg small{display:block;font-size:.45em;margin-top:.8em;color:#ffe45e}
#title{position:absolute;left:0;right:0;top:15%;text-align:center;transition:opacity .6s}
#title h1{font-size:3.2em;font-weight:400;color:#ffe45e;letter-spacing:.04em;line-height:1.2}
#title p{font-size:1em;margin-top:1em}
#title.gone{opacity:0}
.btns{position:absolute;left:1.6vmin;bottom:1.8vmin;display:flex;flex-direction:column;gap:.6em;align-items:flex-start}
.hb{pointer-events:auto;font:inherit;font-size:.8em;color:#fff;background:#3b2a40;border:.25em solid #2b1a2e;padding:.6em .7em;cursor:pointer;box-shadow:.25em .25em 0 rgba(43,26,46,.35)}
.hb:hover{background:#56405c}
#panel{position:absolute;left:50%;top:54%;transform:translate(-50%,-50%);background:#3b2a40;border:.4em solid #2b1a2e;box-shadow:0 0 0 .3em #ffe45e,.6em .6em 0 .3em rgba(43,26,46,.45);padding:1.4em 1.8em;text-align:center;font-size:clamp(7px,1.9vmin,14px);min-width:20em;max-width:94vw}
#panel[hidden]{display:none}
#panel .pt{font-size:1.1em;color:#ffb36b}
#panel .big{font-size:2.6em;color:#ffe45e;margin:.45em 0 .3em}
#panel .row{display:flex;justify-content:center;gap:2.2em;margin:.9em 0 .3em;line-height:1.9;font-size:.85em}
#panel .row b{display:block;font-weight:400;font-size:2em}
#panel .r{color:#ff8a80}#panel .b{color:#9db8ff}
#panel .pd{font-size:.8em;line-height:1.9;margin-top:.5em}
#panel .opt{display:flex;gap:.5em;justify-content:center;margin-top:.8em}
#panel .opt button{font:inherit;font-size:.8em;padding:.6em .7em;color:#fff;background:#2b1a2e;border:.2em solid #6b5a63;cursor:pointer}
#panel .opt button.on{background:#ffe45e;color:#2b1a2e;border-color:#2b1a2e}
#panel .go{font:inherit;font-size:1em;margin-top:1.1em;padding:.8em 1em;color:#2b1a2e;background:#ffe45e;border:.25em solid #2b1a2e;cursor:pointer;box-shadow:inset -.25em -.25em 0 #e0a52a}
#panel .go:hover{background:#fff07f}
#panel .note{font-size:.65em;line-height:1.8;margin-top:1em;opacity:.8}
@media (max-width:560px){#title{top:12%}#title h1{font-size:2.4em}}
#conditions{position:absolute;top:12%;left:0;right:0;text-align:center;font-size:.75em;line-height:1.9}#wind{position:absolute;right:2%;top:35%;padding:10px;background:#3b2a40e6;border:.25em solid #2b1a2e;box-shadow:.25em .25em 0 rgba(43,26,46,.35);color:#ffe45e;text-align:center;font-size:clamp(8px,1.5vmin,12px);line-height:1.7}#wind[hidden]{display:none}#wind-arrow{display:block;margin:2px auto 8px;width:36px;height:36px}#wind-speed{white-space:nowrap}
@media(max-height:450px){#turn{top:24%}#conditions{top:13%}#panel{top:55%;padding:.8em}#title{top:8%}#title h1{font-size:2em}}
#err{position:absolute;inset:0;display:none;align-items:center;justify-content:center;text-align:center;padding:2em;background:#3b2a40;font-size:12px;line-height:2}
#panel{max-height:90vh;overflow:auto} .portrait{width:64px;height:64px;image-rendering:pixelated;margin:8px auto;display:block;border:3px solid #ffe45e}.ladder{font-size:.7em;line-height:2;text-align:left;margin-top:1em}.ladder .done{color:#7ee081}.ladder .current{color:#ffe45e}#save-note{font-size:.65em;color:#ffb36b;margin-top:.8em}@media(max-height:450px){.portrait{width:40px;height:40px;margin:4px auto}.ladder{line-height:1.5}#panel .big{font-size:1.7em}}
#bag-menu{position:absolute;left:1.6vmin;bottom:1.8vmin;width:clamp(156px,23vw,230px);max-height:70%;overflow:auto;pointer-events:auto;background:#3b2a40ed;border:2px solid #2b1a2e;padding:8px;font-size:clamp(7px,1.3vmin,10px);display:flex;flex-direction:column;gap:7px;cursor:default;touch-action:pan-y}
#bag-menu > *{flex-shrink:0}
.bag-row{display:flex;flex-direction:column;gap:4px}.bag-label{color:#ffb36b;font-size:.85em}.bag-choices{display:flex;gap:4px}.bag-choices .hb{flex:1;min-width:0;padding:7px 3px;font-size:.85em}.hb[aria-pressed="true"]{background:#ffe45e;color:#2b1a2e}
#height-choice{display:flex}.btns{position:static;display:flex;flex-direction:row;flex-wrap:wrap;gap:4px}.btns .hb{padding:7px 5px}#setup{display:none}#sweet{box-shadow:inset 0 0 0 1px #fff,0 0 6px #fff;background:#ffffff33}#panel .go{display:block;margin:12px auto}
@media(max-height:450px){#hud,#panel{font-size:10px}#goal,#wind{font-size:9px}#bag-menu{width:200px;max-height:69%;padding:4px;gap:3px;font-size:10px}.bag-row{gap:2px}.bag-label{font-size:9px}.bag-choices .hb,.btns .hb{font-size:9px;min-height:36px;padding:3px 2px}}
/* Mode descriptions share one readable, responsive button column. */
#panel:has(.menu-modes){width:540px;padding:12px;max-width:94vw}
.menu-modes{display:grid;gap:10px}
#panel .menu-modes .go{width:100%;margin:0;padding:14px 8px;font-size:12px;line-height:1.6}
.menu-modes small{display:block;font-size:9px;line-height:1.8;color:#65512f;margin-top:6px}
@media(min-width:1000px) and (min-height:600px){#panel .menu-modes .go{font-size:14px}.menu-modes small{font-size:11px}}
@media(max-height:450px){#panel:has(.menu-modes){top:64%;padding:8px}#panel .menu-modes .go{padding:8px}}
@media(max-width:560px){#panel .menu-modes .go{font-size:11px}.menu-modes small{max-width:100%;text-wrap:balance}}
