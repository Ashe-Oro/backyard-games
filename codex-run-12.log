  for (let p = 0; p <= 1; p += 0.0025) { const r = simulate(RX[t], p, side, 0, 0, arc); if (r === 3) { lo = Math.min(lo, p); hi = Math.max(hi, p); } if (r >= 1) { olo = Math.min(olo, p); ohi = Math.max(ohi, p); } }
