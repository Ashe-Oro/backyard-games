  if (f) release(f.peak, f.up > 0 ? f.side / f.up * f.peak : 0);
}
// The free end droops in calm air; stronger wind extends it and tightens the ripples.
function animatePennant(seconds) {
  const strength=Math.min(1,wind.mph/12), extension=wind.mph>0?.45+.55*strength:0;
  const dx=wind.mph>0?Math.sin(wind.angle):1, dz=wind.mph>0?-Math.cos(wind.angle):0;
  const frequency=2+wind.mph*1.1, amplitude=wind.mph>0?.035*(1-.65*strength):0;
  const pos=pennant.geometry.attributes.position;
  for(let i=0;i<pos.count;i++) {
    const u=(i%17)/16, row=Math.floor(i/17)/6;
    const along=.32*u*extension+.018*u*(1-extension);
    const ripple=Math.sin(seconds*frequency-u*11)*amplitude*u + .012*Math.sin(row*Math.PI*2)*u*(1-extension);
