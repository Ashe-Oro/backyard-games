<body>
<div id="game">
  <div id="hud">
    <div id="sb" class="ol">
      <div class="team red" id="t0"><div class="tn">RED <span id="n0">YOU</span></div><div class="ts" id="s0">0</div><div class="pips" id="p0"></div></div>
      <div class="mid"><div id="inn">INNING 1</div><div id="goal">TO 21</div></div>
      <div class="team blue" id="t1"><div class="tn"><span id="n1">CPU</span> BLUE</div><div class="ts" id="s1">0</div><div class="pips" id="p1"></div></div>
    </div>
    <div id="title" class="ol"><h1>BACKYARD<br>CORNHOLE</h1><p>line up · flick · toss</p></div>
    <div id="turn" class="ol"></div>
    <div id="msg" class="ol"></div>
    <div id="meter"><div id="fill"></div><div id="onb"></div><div id="sweet"></div><div class="mlbl ol">PWR</div></div>
    <div id="wind" class="ol" hidden role="status"><span>WIND</span><span id="wind-arrow" aria-hidden="true">↑</span><span id="wind-speed"></span></div><div id="conditions" class="ol"><div id="setup"></div></div>
    <div id="touch-controls"><button class="hb" data-control="arrowleft" aria-label="STEP ←">STEP ←</button><button class="hb" data-control="arrowright" aria-label="STEP →">STEP →</button><button class="hb" data-control="a" aria-label="AIM ←">AIM ←</button><button class="hb" data-control="d" aria-label="AIM →">AIM →</button><button class="hb" data-control="q" aria-label="SPIN L">SPIN L</button><button class="hb" data-control="e" aria-label="SPIN R">SPIN R</button></div>
    <div id="height-choice"><button class="hb" data-height="0">PUSH</button><button class="hb" data-height="1">NORMAL</button><button class="hb" data-height="2">KOBE</button></div><div id="hint" class="ol"></div>
    <div class="btns"><button class="hb" id="side" title="Which side of the bag lands down (F)">SLICK SIDE</button><button class="hb" id="more">MORE</button><button class="hb" id="reset-bags" hidden>RESET BAGS</button><button class="hb" id="menu">MENU</button><button class="hb" id="mode" hidden title="Toggle controls (M)">MOUSE</button></div>
  </div>
  <div id="panel" class="ol" hidden></div>
  <div id="err">WebGL isn't available here.<br>Open this page in a desktop browser.</div>
</div>
<script type="module">
import * as THREE from 'three';

// ---------- constants (regulation ACL/ACA dimensions, metres) ----------
const G = 9.8;
const IN = 0.0254, FT = 0.3048;
const W = 2 * FT, L = 4 * FT;              // 2 ft x 4 ft deck
const FRONT_H = 3.5 * IN, BACK_H = 12 * IN; // front 2.5-4 in, back 12 in
const TH = Math.asin((BACK_H - FRONT_H) / L);
const BOARD_Z = -27 * FT;                   // 27 ft front edge to front edge; our foul line is z = 0
const HOLE_FROM_TOP = 9 * IN, HOLE_R = 3 * IN; // 6 in hole, centre 9 in from the top
const BAG = 6 * IN, BAG_H = 0.016, BAG_R = 0.074; // 6x6 in, ~1.25 in thick
const SIDES = { slick: { mu: 0.30, ms: 0.5, keep: 0.42 }, sticky: { mu: 0.62, ms: 0.85, keep: 0.30 } };
const MU_GROUND = 1.1, BAG_E = 0.25;
const ELEV = 35 * Math.PI / 180;
const V_MIN = 5.6;
const AIM_MAX = 0.12;
const FLICK_MIN = 0.5, FLICK_MAX = 7.5;     // screen heights / second
const REL_Y = 1.3, REL_Z = -0.45;           // feet stay behind the foul line (z = 0); the hand reaches past it on release
const RX = [0.62, -0.62];                   // red throws from the right pitcher's box, blue from the left
const TEAM = ['RED', 'BLUE'];
const HOLE_WORLD = new THREE.Vector3();

    if (b.state === 'in') { pts[b.team] += 3; inC[b.team]++; }
    else if (b.state === 'board' && !b.dead) { pts[b.team] += 1; onC[b.team]++; }
  }
  return { pts, inC, onC };
}
function renderHud() {
  $('hud').classList.toggle('menu', ['menu', 'intro', 'champion'].includes(M.phase));
  for (const t of [0, 1]) {
    ui.s[t].textContent = M.scores[t];
    ui.n[t].textContent = teamName(t);
    const thrown = bags.filter((b) => b.team === t).length;
    ui.p[t].innerHTML = [0, 1, 2, 3].map((i) => `<i class="${i < thrown ? 'used' : ''}"></i>`).join('');
    ui.t[t].classList.toggle('now', (M.phase === 'aim' || M.phase === 'cpu') && thrower() === t);
  }
  ui.inn.textContent = 'INNING ' + M.inning;
  ui.goal.textContent = M.exact ? 'EXACTLY 21' : 'FIRST TO 21';
  const t = thrower();
  if (M.phase === 'aim' || M.phase === 'cpu') {
    ui.turn.className = 'ol ' + (t ? 'blue' : 'red');
    ui.turn.textContent = M.vs === 'cpu' ? (t === 0 ? 'YOUR THROW' : 'CPU IS THROWING...') : TEAM[t] + "'S THROW";
    ui.turn.style.opacity = 1;
  } else ui.turn.style.opacity = 0;
  $('wind').hidden = wind.mph <= 0;
  $('wind-speed').textContent = `${wind.mph} MPH`;
  $('wind-arrow').style.transform = `rotate(${wind.angle}rad)`;
  $('wind').setAttribute('aria-label', `Wind blowing ${['away','away and right','right','toward you and right','toward you','toward you and left','left','away and left'][Math.round(wind.angle/(Math.PI/4))%8]} at ${wind.mph} miles per hour`);
  document.querySelectorAll('[data-height]').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.height===M.arc)));
  $('reset-bags').hidden=!M.practice;
  ui.t[1].hidden=M.practice;
  if(M.practice){const n=M.practiceStats;ui.inn.textContent='SOLO PRACTICE';ui.goal.textContent=`${n.in} IN · ${n.on} On the Board · ${n.throws ? Math.round((n.in+n.on)/n.throws*100):0}% HIT · ${n.throws} THROWS`;}
  $('setup').textContent = `${arcNames[M.arc]} · SPIN ${M.spin < 0 ? 'L' : M.spin > 0 ? 'R' : '0'} · STEP ${M.position[t].toFixed(2)}`;
  ui.side.textContent = (M.side[t] === 'slick' ? 'SLICK' : 'STICKY') + ' SIDE DOWN';
  ui.side.style.visibility = isHuman(t) ? 'visible' : 'hidden';
  const w = meterWindow();
  ui.sweet.style.bottom = (w.lo * 100) + '%'; ui.sweet.style.height = Math.max(2, (w.hi - w.lo) * 100) + '%';
  ui.onb.style.bottom = (w.olo * 100) + '%'; ui.onb.style.height = Math.max(2, (w.ohi - w.olo) * 100) + '%';
}
function hint() {
  ui.hint.textContent = 'Flick up to throw · Point to aim · Pick PUSH / NORMAL / KOBE';
  ui.mode.textContent = M.ctrl === 'drag' ? '🖱 MOUSE' : '🕹 SPINNER';
  wrap.classList.toggle('spin', M.ctrl === 'spin');
}
let msgTimer;
function say(big, small = '', ms = 1400) {
  ui.msg.innerHTML = big + (small ? `<small>${small}</small>` : ''); ui.msg.classList.add('on');
  clearTimeout(msgTimer); msgTimer = setTimeout(() => ui.msg.classList.remove('on'), ms);
 return {...w,lo:mid-width/2,hi:mid+width/2,mid};
}
function physicalPower(p){
 if(!M.sweetShift)return p;
 const t=thrower(),base=WIN[t+M.side[t]+M.arc],w=meterWindow();
 if(p<w.lo)return p/w.lo*base.lo;
 if(p>w.hi)return base.hi+(p-w.hi)/(1-w.hi)*(1-base.hi);
 return base.lo+(p-w.lo)/(w.hi-w.lo)*(base.hi-base.lo);
}
const aimRay=new THREE.Raycaster(),aimPoint=new THREE.Vector3();
const aimPlane=new THREE.Plane(new THREE.Vector3(0,1,0),-.2);
function pointAim(e){
 const r=wrap.getBoundingClientRect();
 aimRay.setFromCamera(new THREE.Vector2((e.clientX-r.left)/r.width*2-1,1-(e.clientY-r.top)/r.height*2),camera);
 if(aimRay.ray.intersectPlane(aimPlane,aimPoint)){
 const rx=RX[thrower()]+M.position[thrower()];
 M.aim=clamp(Math.atan2(aimPoint.x-rx,REL_Z-aimPoint.z)-baseYaw(rx),-AIM_MAX,AIM_MAX);
 }
}
$('more').onclick=()=>$('touch-controls').classList.toggle('open');
$('menu').onclick=()=>{if(M.active)return;showMenu();};
$('reset-bags').onclick=()=>{if(!humanTurn())return;clearBags();renderHud();};
document.querySelectorAll('[data-height]').forEach(b=>b.onclick=()=>{if(!humanTurn())return;M.arc=+b.dataset.height;M.heights[thrower()]=M.arc;renderHud();});

// ---------- input ----------
let drag = null, keyAim = 0;
const samples = [];
const H = () => wrap.clientHeight || 1;
const humanTurn = () => M.phase === 'aim' && isHuman(thrower());
function flickFrom(list) {
  if (list.length < 2) return null;
  const tEnd = list[list.length - 1].t;
  let i = list.length - 1; while (i > 0 && tEnd - list[i - 1].t < 70) i--;
  if (i === list.length - 1) i = Math.max(0, i - 1);
  const a = list[i], b = list[list.length - 1];
  const dt = Math.max(16, b.t - a.t) / 1000;
  return { up: -(b.y - a.y) / H() / dt, side: (b.x - a.x) / H() / dt };
}
const powerFromSpeed = (up) => clamp((up - FLICK_MIN) / (FLICK_MAX - FLICK_MIN), 0, 1);
function release(up, side) {
  if (up < FLICK_MIN) return false;
  return throwBag(powerFromSpeed(up), clamp(side / Math.max(up, 0.001), -1, 1));
}
wrap.addEventListener('pointerdown', (e) => {
  if (e.target.closest('button') || !ui.panel.hidden) return;
  if (M.ctrl === 'spin' && e.pointerType === 'mouse') { if (!document.pointerLockElement && wrap.requestPointerLock) { try { const r = wrap.requestPointerLock(); if (r && r.catch) r.catch(() => {}); } catch (_) {} } return; }
  if (!humanTurn()) return;
  pointAim(e);
  drag = { id: e.pointerId, list: [{ t: e.timeStamp, x: e.clientX, y: e.clientY }] };
  wrap.classList.add('drag');
  try { wrap.setPointerCapture(e.pointerId); } catch (_) {}
});
wrap.addEventListener('pointermove', (e) => {
  if (M.ctrl === 'spin' && e.pointerType === 'mouse') { spinMove(e); return; }
  if (drag && e.pointerId === drag.id) {
    pointAim(e);
    const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
    for (const c of (evs.length ? evs : [e])) drag.list.push({ t: c.timeStamp, x: c.clientX, y: c.clientY });
    while (drag.list.length > 2 && e.timeStamp - drag.list[0].t > 300) drag.list.shift();
    const f = flickFrom(drag.list); if (f) setMeter(powerFromSpeed(f.up));
  } else if (e.pointerType === 'mouse' && humanTurn() && !keyAim) {
    pointAim(e);
  }
});
function endDrag(e) {
  if (!drag || e.pointerId !== drag.id) return;
  drag.list.push({ t: e.timeStamp, x: e.clientX, y: e.clientY });
  const list = drag.list.filter((s, i, a) => i === 0 || s.t !== a[i - 1].t || s.y !== a[i - 1].y);
  const trimmed = list.length > 2 && list[list.length - 1].y === list[list.length - 2].y ? list.slice(0, -1) : list;
  const stale = e.timeStamp - trimmed[trimmed.length - 1].t > 160;
  const f = stale ? null : flickFrom(trimmed);
  drag = null; wrap.classList.remove('drag');
  if (!f || !release(f.up, f.side)) { if (M.phase === 'aim') setMeter(0); }
}
wrap.addEventListener('pointerup', endDrag);
wrap.addEventListener('pointercancel', () => { drag = null; wrap.classList.remove('drag'); });
let flick = null, lastMoveT = 0;
function spinMove(e) {
  const t = e.timeStamp; lastMoveT = t;
  const dx = e.movementX || 0, dy = e.movementY || 0;
  samples.push({ t, dx, dy });
  while (samples.length && t - samples[0].t > 80) samples.shift();
  let sy = 0, sx = 0; for (const s of samples) { sy += s.dy; sx += s.dx; }
  const span = Math.max(30, t - samples[0].t) / 1000;
  const up = -sy / H() / span;
  if (M.phase === 'summary' || M.phase === 'over') { if (up > FLICK_MIN * 2 && M.phase === 'summary') advance(); return; }
  if (!humanTurn()) return;
  if (!flick) {
    if (up > FLICK_MIN * 1.4) flick = { t0: t, peak: up, side: 0, up: 0 };
    else M.aim = clamp(M.aim + dx * 0.0007, -AIM_MAX, AIM_MAX);
  }
  if (flick) {
    flick.peak = Math.max(flick.peak, up); flick.side += dx; flick.up += -dy;
