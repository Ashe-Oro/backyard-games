let wheelGesture = [], wheelTimer;
wrap.addEventListener('wheel', e => {
  e.preventDefault();
  if (!humanTurn() || !ui.panel.hidden) return;
  const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? H() : 1;
  wheelGesture.push({t: performance.now(), x: e.deltaX * unit, y: e.deltaY * unit});
  clearTimeout(wheelTimer);
  wheelTimer = setTimeout(() => {
    const g = wheelGesture; wheelGesture = [];
    const up = -g.reduce((n,s) => n+s.y,0) / H() / Math.max(.08,(g.at(-1).t-g[0].t)/1000);
    release(up, g.reduce((n,s)=>n+s.x,0) / H());
  }, 90);
}, {passive:false});
addEventListener('blur', () => { keyAim = 0; drag = null; });
addEventListener('keydown', (e) => {
  if (e.repeat) return;
  const k = e.key.toLowerCase();
  if (k === 'a') keyAim = -1;
  else if (k === 'd') keyAim = 1;
  else if (['arrowleft','arrowright','q','e','h'].includes(k)) { e.preventDefault(); adjust(k); }
  else if (k === 'm') toggleCtrl();
  else if (k === 'f') flipSide();
  else if (k === ' ' || k === 'enter') {
    e.preventDefault();
    if (M.phase === 'summary' || M.phase === 'over') advance();

  }
});
addEventListener('keyup', (e) => {
  const k = e.key.toLowerCase();
  if (k === 'a' && keyAim < 0) keyAim = 0;
  if (k === 'd' && keyAim > 0) keyAim = 0;
});

// The free end droops in calm air; stronger wind extends it and tightens the ripples.
function animatePennant(seconds) {
  const strength=Math.min(1,wind.mph/12), extension=wind.mph>0?.45+.55*strength:0;
  const dx=wind.mph>0?Math.sin(wind.angle):1, dz=wind.mph>0?-Math.cos(wind.angle):0;
  const frequency=2+wind.mph*1.1, amplitude=wind.mph>0?.035*(1-.65*strength):0;
  const pos=pennant.geometry.attributes.position;
  for(let i=0;i<pos.count;i++) {
    const u=(i%17)/16, row=Math.floor(i/17)/6;
    const along=.32*u*extension+.018*u*(1-extension);
    const ripple=Math.sin(seconds*frequency-u*11)*amplitude*u + .012*Math.sin(row*Math.PI*2)*u*(1-extension);
    pos.setXYZ(i,dx*along-dz*ripple,-.2*row*(1-.8*u)-.30*u*(1-extension),dz*along+dx*ripple);
  }
  pos.needsUpdate=true;pennant.geometry.computeVertexNormals();pennant.geometry.computeBoundingSphere();
  pennant.userData={extension,frequency,amplitude};
}

// ---------- loop ----------
const clock = new THREE.Clock();
let acc = 0, time = 0;
const lookTmp = new THREE.Vector3(), camTmp = new THREE.Vector3();
const CAM_LOOK = new THREE.Vector3(0, 0.5, -8.7);
camera.userData.look = CAM_LOOK.clone();
function frame() {
  const dt = Math.min(clock.getDelta(), 0.05); time += dt;
  if (keyAim && humanTurn()) M.aim = clamp(M.aim + keyAim * dt * 0.12, -AIM_MAX, AIM_MAX);
  if (flick && performance.now() - lastMoveT > 60) finishFlick();
