  "rules": [
    { "id": "points-in-hole", "value": 3, "snippet": "if (b.state === 'in') { pts[b.team] += 3; inC[b.team]++; }", "file": "game" },
    { "id": "points-on-board", "value": 1, "snippet": "else if (b.state === 'board' && !b.dead) { pts[b.team] += 1; onC[b.team]++; }", "file": "game" },
    { "id": "cancellation-scoring", "value": "net = |red - blue|, awarded to the higher side; a tie is a wash", "snippet": "const net = Math.abs(pts[0] - pts[1]);", "file": "game" },
    { "id": "target-score", "value": 21, "snippet": "(M.exact ? M.scores[scorer] === 21 : M.scores[scorer] >= 21)", "file": "game" },
    { "id": "exact-21-bust-to", "value": 13, "note": "only in EXACTLY 21 mode", "snippet": "if (M.exact && M.scores[scorer] > 21) { M.scores[scorer] = 13; bust = true; }", "file": "game" },
    { "id": "last-scorer-throws-first", "value": true, "note": "a wash keeps the same order", "snippet": "M.first = scorer;", "file": "game" },
    { "id": "bags-per-inning", "value": 8, "note": "4 per team, alternating", "snippet": "if (!M.practice && M.k >= 8) { M.phase = 'settle'; renderHud(); return; }", "file": "game" },
    { "id": "alternating-throws", "value": true, "snippet": "const thrower = (k = M.k) => M.practice ? 0 : (k % 2 === 0 ? M.first : 1 - M.first);", "file": "game" },
    { "id": "grounder-is-dead", "value": true, "note": "a bag that touches grass first scores nothing", "snippet": "else if (b.dead) say('GROUNDER', 'GRASS FIRST · NO SCORE', 1300);", "file": "game" }
