function scoreInning() {
  const { pts, inC, onC } = lie();
  const net = Math.abs(pts[0] - pts[1]);
  const scorer = pts[0] > pts[1] ? 0 : pts[1] > pts[0] ? 1 : -1;
  let bust = false;
  if (scorer >= 0) {
    M.scores[scorer] += net;
    if (M.exact && M.scores[scorer] > 21) { M.scores[scorer] = 13; bust = true; }
    M.first = scorer;                 // last scoring team throws first; a wash keeps the same order
  }
  const win = scorer >= 0 && (M.exact ? M.scores[scorer] === 21 : M.scores[scorer] >= 21) ? scorer : -1;
  M.history.push({ inning: M.inning, pts, inC, onC, net, scorer, bust, scores: [...M.scores] });
  M.phase = win >= 0 ? 'over' : 'summary'; M.winner = win;
  renderHud();
  const head = win >= 0 ? `<div class="pt">FINAL</div><div class="big ${win ? 'b' : 'r'}">${M.vs === 'cpu' ? (win === 0 ? 'YOU WIN!' : 'CPU WINS') : TEAM[win] + ' WINS!'}</div>`
    : `<div class="pt">INNING ${M.inning}</div><div class="big">${scorer < 0 ? 'WASH' : TEAM[scorer] + ' +' + net}</div>`;
  ui.panel.innerHTML = head + `
    <div class="row"><div class="r">RED<b>${pts[0]}</b>${inC[0]} IN · ${onC[0]} ON</div><div>vs</div><div class="b">BLUE<b>${pts[1]}</b>${inC[1]} IN · ${onC[1]} ON</div></div>
    <div class="pd">${scorer < 0 ? 'EQUAL INNING · NOBODY SCORES' : `${pts[scorer]} − ${pts[1 - scorer]} = ${net} (CANCELLATION)`}${bust ? '<br><span style="color:#ff8a80">BUST! OVER 21 · BACK TO 13</span>' : ''}<br>
    MATCH: <span class="r">RED ${M.scores[0]}</span> · <span class="b">BLUE ${M.scores[1]}</span><br>
    ${win >= 0 ? '' : `${TEAM[M.first]} THROWS FIRST NEXT`}</div>
    <button class="go" id="go">${win >= 0 ? 'NEW MATCH' : 'NEXT INNING'}</button>`;
  ui.panel.hidden = false;
  $('go').onclick = (e) => { e.stopPropagation(); advance(); };
  if(win>=0 && M.career) careerResult(win);
}
function advance() {
  if (M.phase === 'summary') { ui.panel.hidden = true; M.inning++; beginInning(); }
  else if (M.phase === 'over') { clearBags(); showMenu(); }
}


