  const down = side === 'slick' ? m.slick : m.sticky;
  const mesh = new THREE.Mesh(bagGeo, [up, up, up, down, up, up]);
  mesh.castShadow = true; mesh.receiveShadow = true; scene.add(mesh); return mesh;
}
