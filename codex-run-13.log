const bagGeo = (() => {
  const g = new THREE.BoxGeometry(BAG, BAG_H * 2, BAG, 4, 1, 4);
  const p = g.attributes.position;
  for (let i = 0; i < p.count; i++) {
    const x = p.getX(i) / (BAG / 2), z = p.getZ(i) / (BAG / 2);
    p.setY(i, p.getY(i) * (1 - 0.45 * (x * x + z * z) / 2));
  }
  g.computeVertexNormals(); return g;
})();
