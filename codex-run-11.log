 $('back').onclick=careerMap; $('restart').onclick=()=>{career={fight:0,wins:0};saveCareer();careerMap();}; burst(HOLE_WORLD); renderHud();
}
function careerResult(win){
 const o=roster[career.fight]; if(win===0){career.fight++;career.wins++;saveCareer();}
 ui.panel.innerHTML=`<div class="pt">${win===0?'CIRCUIT VICTORY':'RIVAL WINS'}</div>${portrait(o)}<div class="pd">${win===0?'You beat':'You lost to'} ${o.name}<br>${M.scores[0]} – ${M.scores[1]}<br>${win===0?'Next rival unlocked!':'Your progress is safe. Try again!'}<br>${saveNote}</div><button class="go" id="next-fight">${win===0?(career.fight===8?'CLAIM THE CROWN':'NEXT UP'):'REMATCH'}</button><button class="hb" id="back">CIRCUIT MAP</button>`;
 $('next-fight').onclick=()=>career.fight===8?champion():careerIntro(); $('back').onclick=careerMap;
}
function planCareerShot(o){
 // Predict actual flight and board friction, then value strategic landing targets.
 const deck=bags.filter(onDeck), blockers=deck.filter(b=>b.lp.z>HOLE_LOCAL.z+.12);
 let arc=o.style==='slider'?0:o.style==='lobber'?2:o.style==='blocker'?0:1;
 if(o.level>=3 && blockers.length) arc=2;
 let side=o.style==='sniper'||o.style==='blocker'?'sticky':'slick';
 let target=HOLE_LOCAL.clone(), goal='hole';
 const own=deck.find(b=>b.team===1 && holeDist(b.lp)<.35), enemy=deck.find(b=>b.team===0);
 if(o.level>=2 && own && o.style!=='lobber'){target.copy(own.lp);arc=0;side='slick';goal='push';}
 else if(o.level>=4 && enemy && M.scores[0]>=18){target.copy(enemy.lp);arc=0;goal='knock';}
 else if(o.style==='blocker' && !blockers.length && M.scores[1]>=M.scores[0]){target.z+=.38;goal='block';}
 let best={cost:Infinity,power:.55,aim:0};
 // Later opponents compensate with the full match wind; early opponents are less precise.
 for(let power=.35;power<=.85;power+=.0125) for(let aim=-.06;aim<=.061;aim+=.012){
  const b=newBody(1,side);launch(b,RX[1],power,aim,0,arc);
  for(let i=0;i<960;i++){step(b,1/120);if(['board','grass','in','removed'].includes(b.state))break;}
  let cost=b.lp.distanceTo(target); if(b.state==='in')cost=goal==='hole'?-2:.5;
  if(b.state==='grass'||b.state==='removed')cost+=3;
  if(cost<best.cost)best={cost,power,aim};
 }
 const error=.045-o.level*.005, wild=o.style==='wild'?2:1;
 M.arc=arc;M.spin=0;M.side[1]=side;
 return {t:0,side,power:clamp(best.power+gauss()*error*wild,0,1),aim:best.aim+gauss()*error*.23*wild,drift:gauss()*.05,goal};
}
function showMenu() {
  M.phase = 'menu'; ui.title.classList.remove('gone');
