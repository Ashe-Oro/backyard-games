 ui.panel.innerHTML=`<div class="pt">${circuits[o.circuit]} · FIGHT ${career.fight+1}/8</div><div class="pd">NEXT UP: ${o.name}</div>${portrait(o)}<div class="pd">“${o.nick}” · ${o.home}<br>RECORD ${o.record}<br>${o.taunt}<br>${o.style.toUpperCase()} · ${o.circuit===0?'CALM AIR':o.circuit===1?'LIGHT WIND':'STRONG WIND'}</div><button class="go" id="fight">LET’S TOSS</button><button class="hb" id="back">CIRCUIT MAP</button>`;
 ui.panel.hidden=false; $('fight').onclick=()=>startMatch({career:true,vs:'cpu',exact:false}); $('back').onclick=careerMap; renderHud();
}
