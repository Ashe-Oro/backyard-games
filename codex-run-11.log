 return `<svg class="portrait" viewBox="0 0 16 16" role="img" aria-label="Pixel portrait of ${o.name}" shape-rendering="crispEdges"><rect width="16" height="16" fill="#252237"/><path fill="${o.color}" d="M2 12h12v4H2z"/><path fill="${hair}" d="M4 3h8v9H4z${female?'M3 5h2v8H3zM11 5h2v8h-2z':''}"/><path fill="${['#f5be91','#b97851','#df9c70'][o.level%3]}" d="M5 5h6v6H5zM6 11h4v2H6z"/><path fill="#272034" d="M6 6h1v1H6zM9 6h1v1H9zM7 9h3v1H7z"/><path fill="${o.color}" d="M3 3h10v2H3zM5 2h6v1H5z"/>${o.level>=5?'<path fill="#ffe45e" d="M4 1h1v2H4zM7 0h2v3H7zM11 1h1v2h-1z"/>':''}</svg>`;
}
function careerMap(){
