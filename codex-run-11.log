      <div class="team red" id="t0"><div class="tn"><span id="n0">YOU</span></div><div class="ts" id="s0">0</div><div class="pips" id="p0"></div></div>
      <div class="mid"><div id="inn">INNING 1</div><div id="goal">TO 21</div></div>
      <div class="team blue" id="t1"><div class="tn"><span id="n1">CPU</span></div><div class="ts" id="s1">0</div><div class="pips" id="p1"></div></div>
  ui.sweet.style.bottom = (w.lo * 100) + '%'; ui.sweet.style.height = ((w.hi - w.lo) * 100) + '%';
  ui.onb.style.bottom = (w.olo * 100) + '%'; ui.onb.style.height = Math.max(2, (w.ohi - w.olo) * 100) + '%';
}
function hint() {
  ui.mode.textContent = M.ctrl === 'drag' ? '🖱 MOUSE' : '🕹 SPINNER';
  wrap.classList.toggle('spin', M.ctrl === 'spin');
}
let msgTimer;
function say(big, small = '', ms = 1400) {
  ui.msg.innerHTML = big + (small ? `<small>${small}</small>` : ''); ui.msg.classList.add('on');
  clearTimeout(msgTimer); msgTimer = setTimeout(() => ui.msg.classList.remove('on'), ms);
}
function setMeter(p) { ui.fill.style.height = (clamp(p, 0, 1) * 100) + '%'; }
const gauss = () => { let u = 0, v = 0; while (!u) u = Math.random(); while (!v) v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

function clearBags() { for (const b of bags) scene.remove(b.mesh); bags.length = 0; }
// Career saves only completed fights; an interrupted match restarts the current opponent.
const roster = [
 ['Slidin’ Steve','The Patio Pusher','Beanbag Bend','2–7','Your bags are in my driveway!','slider','#45bca4',0],
 ['Big Bag Barb','Queen of the Cookout','Biscuit Bay','5–3','Hope you brought a bigger picnic!','blocker','#ed83bb',0],
 ['Kobe Kowalski','The Sky Slinger','Popcorn Plains','9–4','Forecast: bags from above!','lobber','#f6b642',1],
 ['Sticky Vicky','The Suede Sorceress','Velcro Valley','12–3','This victory is going to stick!','sniper','#a57cf0',1],
 ['Tailgate Ted','The Parking Lot Tornado','Grillville','16–5','I put the wild in wild card!','wild','#73b5f3',2],
 ['Slidin’ Steve II','Patio Pusher: Reloaded','Beanbag Bend','21–7','Same driveway. Double trouble!','slider','#26dcbb',2],
 ['Big Bag Barb II','The Cookout Empress','Biscuit Bay','28–3','You’re the side dish today!','blocker','#ff509f',3],
 ['Reign Supreme','The Bag Baroness','Crown Corners','35–0','The throne has no room for two!','champion','#ffe45e',3]
].map((r,i)=>({name:r[0],nick:r[1],home:r[2],record:r[3],taunt:r[4],style:r[5],color:r[6],circuit:r[7],level:i}));
const circuits=['Backyard Circuit','County Fair','Tailgate Pro','King’s Court'];
const SAVE_KEY='backyard-cornhole-career-v1';
let career={fight:0,wins:0}, saveNote='';
try { const c=JSON.parse(localStorage.getItem(SAVE_KEY)); if(c && Number.isInteger(c.fight) && c.fight>=0 && c.fight<=roster.length && Number.isInteger(c.wins) && c.wins>=c.fight) career={fight:c.fight,wins:c.wins}; } catch { saveNote='Storage unavailable: progress lasts this visit.'; }
