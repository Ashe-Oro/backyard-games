    assert data['gap']<1e-9 and data['preview']<1e-9,data
    assert data['radius']<data['hole'],data
    assert .2*w<data['bag']['x']<.8*w and .55*h<data['bag']['y']<.92*h,data
    assert max(v['x'] for v in data['board'])-min(v['x'] for v in data['board'])> (55 if w<500 else 110),data
    fixed=data['camera']
