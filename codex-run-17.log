// states: fly -> slide/board (on deck) | ground/grass (on lawn) | hole -> in | removed (dead bag taken away)
function newBody(team, side = 'slick') {
  return { team, side, spin: 0, tumble: 1, arc: 1, state: 'fly', p: new THREE.Vector3(), v: new THREE.Vector3(), lp: new THREE.Vector3(), lv: new THREE.Vector3(), prev: new THREE.Vector3(), curl: 0, touched: false, dead: false, swish: false, offBoard: false, t: 0, restT: 0 };
}
const wind = { x: 0, z: 0, mph: 0, angle: 0 };
const arcs = [24, 35, 58], arcNames = ['PUSH', 'NORMAL', 'KOBE'];
function launch(b, rx, power, aim, drift, arc = 1, spin = 0) {
  const pwr = clamp(power, 0, 1);
  const speed = pwr < 0.4 ? V_MIN + pwr * 6 : 8 + (pwr - 0.4) * 3.2;
  const elev = arcs[arc] * Math.PI / 180;
  // Normalize range across arcs; a lob spends longer in the wind.
  const velocity = speed * Math.sqrt(Math.sin(2 * ELEV) / Math.sin(2 * elev));
  const y = baseYaw(rx) + aim + drift * 0.04;
  b.p.set(rx, REL_Y, REL_Z);
  b.v.set(Math.sin(y) * Math.cos(elev) * velocity, Math.sin(elev) * velocity, -Math.cos(y) * Math.cos(elev) * velocity);
  b.arc = arc; b.english = spin; b.spin = spin * 3; b.curl = drift * 0.12 + spin * 0.10; b.state = 'fly';
  toLocal(b.p, b.prev);
}
const onDeck = (b) => b.state === 'slide' || b.state === 'board';
function step(b, dt) {
  b.t += dt;
  const S = SIDES[b.side];
  if (b.state === 'fly') {
    b.v.x += (wind.x + b.curl * Math.sin(b.t * 5)) * dt; b.v.z += wind.z * dt; b.v.y -= G * dt; b.p.addScaledVector(b.v, dt);
    const lp = toLocal(b.p, b.lp);
    const inX = Math.abs(lp.x) <= W / 2, inZ = lp.z <= 0 && lp.z >= -L;
    if (inX && inZ && lp.y <= BAG_H && lp.y > -0.14 && !b.offBoard) {
      if (b.prev.y > BAG_H - 0.005) {
        const lv = b.lv.copy(b.v).applyQuaternion(boardQi);
        b.touched = true;
        if (holeDist(lp) < HOLE_R * 0.9) { b.state = 'hole'; b.swish = true; b.hy = BAG_H; return 'hole'; }
        lv.y = 0; lv.multiplyScalar(S.keep * (b.arc === 2 ? 0.40 : b.arc === 0 ? 1.35 : 1)); lp.y = BAG_H; b.state = 'slide';
        return 'land';
      } else if (b.prev.z > 0) { b.touched = true; b.v.z = Math.abs(b.v.z) * 0.2; b.v.x *= 0.4; b.p.z = BOARD_Z + 0.03; }
      else { b.touched = true; b.v.x *= -0.3; }
    }
    if (b.p.y <= BAG_H) {
      if (!b.touched) b.dead = true;       // hit the grass before the board: foul bag, removed
      b.p.y = BAG_H; b.v.y = 0; b.v.x *= 0.25; b.v.z *= 0.25; b.state = 'ground'; return 'ground';
    }
    b.prev.copy(lp);
  } else if (b.state === 'slide') {
    const lp = b.lp, lv = b.lv;
    lp.y += (BAG_H - lp.y) * Math.min(1, dt * 12);
    lv.x += (G_LOCAL.x + b.curl) * dt; lv.z += G_LOCAL.z * dt;
    const sp = Math.hypot(lv.x, lv.z), dec = S.mu * G_N * dt;
    if (sp <= dec) { lv.x = 0; lv.z = 0; } else { lv.x -= lv.x / sp * dec; lv.z -= lv.z / sp * dec; }
    b.curl *= Math.pow(0.2, dt);
    lp.x += lv.x * dt; lp.z += lv.z * dt;
    if (holeDist(lp) < HOLE_R - 0.012) { b.state = 'hole'; b.hy = BAG_H; return 'hole'; }
    if (Math.abs(lp.x) > W / 2 + 0.01 || lp.z > 0.01 || lp.z < -L - 0.01) {
