*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#ffcf99;touch-action:none;user-select:none;-webkit-user-select:none}
body{font-family:'Press Start 2P',ui-monospace,Menlo,monospace;color:#fff}
#game{position:fixed;inset:0;cursor:grab}
#game.drag{cursor:grabbing}
#game.spin{cursor:crosshair}
canvas{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges}
.ol{text-shadow:2px 0 #2b1a2e,-2px 0 #2b1a2e,0 2px #2b1a2e,0 -2px #2b1a2e,2px 2px #2b1a2e,-2px 2px #2b1a2e,2px -2px #2b1a2e,-2px -2px #2b1a2e}
#hud{position:absolute;inset:0;pointer-events:none;font-size:clamp(7px,1.9vmin,14px)}
#sb{position:absolute;left:0;right:0;top:1.4vmin;display:flex;justify-content:space-between;align-items:flex-start;padding:0 1.6vmin}
.team{min-width:9em}.team.blue{text-align:right}
.tn{font-size:.9em;letter-spacing:.06em}
.red .tn{color:#ff8a80}.blue .tn{color:#9db8ff}
.ts{font-size:2.6em;margin-top:.3em;color:#ffe45e}
.pips{display:flex;gap:.4em;margin-top:.6em}.blue .pips{justify-content:flex-end}
.pips i{display:block;width:1.4em;height:1.4em;border:.22em solid #2b1a2e;box-shadow:inset -.22em -.22em 0 rgba(0,0,0,.25),inset .18em .18em 0 rgba(255,255,255,.35)}
.red .pips i{background:#e8423c}.blue .pips i{background:var(--rival,#3f6ee8)}
.pips i.used{background:#6b5a63!important;opacity:.4;box-shadow:none}
.team.now .tn::before{content:'▶ ';color:#ffe45e}
.blue.now .tn::before{content:''}.blue.now .tn::after{content:' ◀';color:#ffe45e}
