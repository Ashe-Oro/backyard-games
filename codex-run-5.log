const FLICK_MIN = 0.5, FLICK_MAX = 7.5;     // screen heights / second
const REL_Y = 1.3, REL_Z = -0.45;           // feet stay behind the foul line (z = 0); the hand reaches past it on release
const RX = [0.62, -0.62];                   // red throws from the right pitcher's box, blue from the left
const TEAM = ['RED', 'BLUE'];
}
