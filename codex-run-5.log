    acc -= 1 / 240;
    for (const b of bags) if (b.state !== 'in' && b.state !== 'removed' && !(b.state === 'grass' && !b.dead) && b.state !== 'board') step(b, 1 / 240);
    collide(bags);
  }
  if (M.phase === 'flying' && M.active && settled()) afterThrow();
  if (M.phase === 'settle' && settled()) scoreInning();
  for (const b of bags) {
    const m = b.mesh; m.position.copy(b.p);
    if (b.state === 'fly') { m.rotation.y += b.spin * dt; m.rotation.x = Math.sin(b.t * b.tumble) * 0.25; m.rotation.z = Math.cos(b.t * b.tumble * 0.7) * 0.15; }
    else if (onDeck(b) || b.state === 'hole') { const yaw = b.yaw ?? (b.yaw = m.rotation.y); if (b.state === 'slide') b.yaw += b.spin * dt * 0.3; m.quaternion.copy(boardQ); m.rotateY(b.yaw); }
    else if (b.state === 'ground' || b.state === 'grass') { m.rotation.x = 0; m.rotation.z = 0; }
    m.visible = b.state !== 'in' && b.state !== 'removed';
    if (b.state === 'slide') b.spin *= Math.pow(0.1, dt);
  }
  // camera stands behind whoever is throwing
  const t = thrower(), rx = RX[t];
  const showHeld = M.phase === 'aim' || M.phase === 'cpu';
  const yaw = baseYaw(rx) + M.aim;
  held.visible = showHeld;
  if (showHeld) { held.position.set(rx + Math.sin(time * 2) * 0.004, REL_Y + Math.sin(time * 3) * 0.01, REL_Z); held.rotation.set(0.15, -yaw, 0); }
  aimDots.forEach((d, i) => {
    const dist = 1.6 + i * 0.5;
    d.position.set(rx + Math.sin(yaw) * dist, 0.012, REL_Z - Math.cos(yaw) * dist);
    d.visible = showHeld && isHuman(t);
    d.material.opacity = 0.35 + 0.4 * (0.5 + 0.5 * Math.sin(time * 6 - i * 0.6));
  });
  const camRx = M.phase === 'menu' ? 0.3 : rx;
  camTmp.set(camRx * 0.85 + M.aim * 2, 2.05, 2.45);
  camera.position.lerp(camTmp, Math.min(1, dt * 3));
  const fb = M.active && M.active.state === 'fly' ? M.active.p : null;
  lookTmp.copy(CAM_LOOK); lookTmp.x += M.aim * 6; if (fb) lookTmp.lerp(fb, 0.1);
  camera.userData.look.lerp(lookTmp, Math.min(1, dt * 3)); camera.lookAt(camera.userData.look);
  for (const c of clouds) { c.position.x += dt * 0.35; if (c.position.x > 50) c.position.x = -50; }
  for (const bl of bulbs) bl.gl.material.opacity = 0.5 + 0.25 * Math.sin(time * 2 + bl.ph);
