   if fight==6:
    old=w['mid'];await page.evaluate('__game.throwWith(0)');await page.wait_for_function('__game.state.phase==="aim"')
    assert await page.evaluate('__game.state.sweet.mid')!=old
  assert len(set(mids))==4
